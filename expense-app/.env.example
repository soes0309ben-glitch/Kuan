# 複製成 .env 後填入（.env 不會進 git）
SECRET_KEY=
BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./expense.db

# LINE Messaging API channel（聊天機器人）：LINE Developers → Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 選填：官方帳號的加好友連結，例如 https://line.me/R/ti/p/@123abcde
LINE_BOT_ADD_FRIEND_URL=

# LINE Login channel（網頁登入）：必須和上面的 Messaging API channel 在「同一個 Provider」底下，
# 兩邊拿到的 userId 才會相同，網頁登入後就自動看到在 LINE 記的帳
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# 選填：排程（每日提醒、月報）呼叫 /cron/* 時帶的 X-Cron-Token
CRON_TOKEN=
# 本機開發用：設為 true 才會出現「開發者登入」，正式環境請勿開啟
DEV_LOGIN=false
