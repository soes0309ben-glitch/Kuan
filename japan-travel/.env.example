# 複製這個檔案為 .env（.env 已被 .gitignore 排除，不會進版控）。
# 不要把真實金鑰寫進任何會被 git 追蹤的檔案。

# 用來簽章 session cookie，正式環境請換成隨機字串，例如 python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-secret-change-me

DATABASE_URL=sqlite:///./japan_travel.db

# 網站對外的基準網址，Stripe Checkout 完成後會導回這個網址
BASE_URL=http://127.0.0.1:8000

# Stripe 測試金鑰：https://dashboard.stripe.com/test/apikeys （先用 test 開頭的金鑰，不要用 live）
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# 本機測試用 `stripe listen --forward-to localhost:8000/webhooks/stripe` 取得
STRIPE_WEBHOOK_SECRET=

# Unsplash 免費 Access Key：https://unsplash.com/developers （建立 App 即可取得，免審核）
UNSPLASH_ACCESS_KEY=

# NewsAPI 免費 Key：https://newsapi.org/register （用來顯示「日本旅遊新聞」頁，每 24 小時自動更新一次）
# 注意：NewsAPI 免費方案條款只允許開發/測試用途，正式對外上線的網站要用付費方案。
NEWSAPI_KEY=

# Resend 免費 Email API Key：https://resend.com/api-keys （有新會員註冊／付款成功時會寄通知信）
RESEND_API_KEY=
# 通知信要寄到哪個信箱（你自己的信箱）
NOTIFY_EMAIL=
# 寄件者信箱，測試階段可先用 Resend 提供的 onboarding@resend.dev
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# 管理後台（/admin）允許登入的 Email，逗號分隔，例如 you@example.com,partner@example.com
ADMIN_EMAILS=
